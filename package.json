{
  "name": "synapse",
  "version": "1.0.0",
  "description": "Synapse - a local-first AI practice coach and live call assistant for interview preparation",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/run-electron.js",
    "start:hidden": "node scripts/run-electron.js --start-hidden",
    "dev": "node scripts/run-electron.js --enable-logging",
    "build": "node scripts/run-build.js",
    "build:win": "node scripts/run-build.js --win portable",
    "build:mac": "node scripts/run-build.js --mac",
    "build:linux": "node scripts/run-build.js --linux",
    "icons": "node scripts/generate-icons.js",
    "build:native": "node scripts/build-native-audio.js --force",
    "test": "node scripts/run-tests.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.3.1",
    "pdf-parse": "^1.1.1",
    "screenshot-desktop": "^1.15.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.6"
  },
  "build": {
    "publish": [
      {
        "provider": "generic",
        "url": "https://example.com"
      }
    ],
    "appId": "com.synapse.interviewcoach",
    "productName": "Synapse",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!.git/**/*",
      "!dist/**/*"
    ],
    "asarUnpack": [
      "node_modules/screenshot-desktop/**/*"
    ],
    "afterPack": "scripts/after-pack.js",
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icon.icns",
      "minimumSystemVersion": "13.0",
      "extraResources": [
        {
          "from": "native/macos-audio-capture/build/synapse-audio-capture",
          "to": "native/synapse-audio-capture"
        }
      ],
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "Synapse listens to your Mac's audio output so it can transcribe the other person on your call. Your speakers or headphones keep working normally.",
        "NSMicrophoneUsageDescription": "Synapse transcribes your microphone so it can coach you on the answers you give during practice.",
        "NSCameraUsageDescription": "Not used by Synapse.",
        "NSAppleEventsUsageDescription": "Synapse inserts a drafted answer into your focused editor when you explicitly ask it to."
      }
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "fileAssociations": []
    },
    "portable": {
      "artifactName": "Synapse-${version}.exe"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "author": "Shubham",
  "license": "MIT"
}
