# Copy to .env.local for local dev. Placeholders only; never commit real values.

# Postgres connection string (Neon in production: the pooled "-pooler" connection string, with sslmode=require).
# Use a separate database per environment: local dev, Vercel Preview (a Neon branch), Vercel Production.
DATABASE_URL=postgres://localhost/synapse_web_dev
# Optional. Connections per server instance. Keep small on Vercel.
# PG_POOL_MAX=5

# Private Vercel Blob read-write token (server only, never NEXT_PUBLIC_). When set, resume PDFs go
# browser -> private Blob (direct upload) and are served by short-lived signed URLs, which is how PDFs
# above Vercel's 4.5 MB Function body limit work. Required when VERCEL_ENV=production.
# Leave empty locally: PDFs are then stored in Postgres (resumes.file_bytes), limited to ~4 MB by hosting.
BLOB_READ_WRITE_TOKEN=

# Server-only Gemini key for AI interview prep. Leave empty to disable AI prep.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=

# Optional. Set to "disable" only for a local non-TLS production-mode run
# (npm start over http). Leave unset on Vercel: cookies are then Secure.
# INSECURE_COOKIES=1

# Vercel build command: set the project's Build Command to `npm run build:vercel`.
# It applies additive migrations (node scripts/migrate.mjs) only when VERCEL_ENV is production or preview
# and DATABASE_URL is set, then runs next build. Anywhere else it only builds. Preview must use its own
# DATABASE_URL (a Neon branch), never the production one.
